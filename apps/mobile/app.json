{
  "expo": {
    "name": "FitSphere Coach",
    "slug": "fitsphere-coach",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fitspherecoach",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitsphere.coach"
    },
    "android": {
      "package": "com.fitsphere.coach",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "630b412d-0724-4178-8f69-d4a4713d36b8"
      }
    },
    "owner": "unnati20112002"
  }
}
